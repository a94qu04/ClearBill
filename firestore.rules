rules_version = '2';

// ClearBill（清帳）Firebase Firestore 多人即時協作安全規則
// 請複製本檔案內容至 Firebase Console > Firestore Database > Rules 並點擊「發布」
service cloud.firestore {
  match /databases/{database}/documents {
    // 預設拒絕所有未明確授權之存取
    match /{document=**} {
      allow read, write: if false;
    }

    match /shared_projects/{shareId} {
      // 嚴禁掃描或列舉所有共享專案
      allow list: if false;

      // 建立新共享專案：須通過匿名登入（或正式登入），且帶入高熵 accessKey 與自身 UID
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.accessKey is string
        && request.resource.data.accessKey.size() >= 16;

      // 讀取單一共享專案：允許團主或已透過邀請金鑰加入 memberUids 之成員
      allow get: if request.auth != null
        && (
          request.auth.uid == resource.data.ownerUid
          || request.auth.uid in resource.data.memberUids
        );

      // 更新共享專案：
      // 1) 團主可更新專案資訊或重設邀請金鑰（accessKey，使舊邀請連結失效），且不可移除自身
      // 2) 已加入成員可更新專案資訊（但不得竄改 ownerUid、accessKey 或 memberUids）
      // 3) 新旅伴須提交 `lastJoinProof == "<自己的UID>:<目前accessKey>"`（強制變動欄位，防範未帶 accessKey 繞過）
      //    且僅允許將自己的單一 UID 加入 memberUids
      allow update: if request.auth != null && (
        (
          request.auth.uid == resource.data.ownerUid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids is list
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.accessKey is string
          && request.resource.data.accessKey.size() >= 16
        )
        || (
          request.auth.uid in resource.data.memberUids
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.accessKey == resource.data.accessKey
          && request.resource.data.memberUids == resource.data.memberUids
        )
        || (
          !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'lastJoinProof'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll(['memberUids', 'lastJoinProof'])
          && request.resource.data.lastJoinProof == (request.auth.uid + ':' + resource.data.accessKey)
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.auth.uid in request.resource.data.memberUids
        )
      );

      // 禁止直接硬刪除共享專案文件（一律透過軟刪除 isDeleted 同步）
      allow delete: if false;

      // 共享專案底下的單筆交易子集合（每筆交易獨立文件，避免多人同時記帳互蓋）
      match /transactions/{txId} {
        allow read, create, update: if request.auth != null
          && (
            request.auth.uid == get(/databases/$(database)/documents/shared_projects/$(shareId)).data.ownerUid
            || request.auth.uid in get(/databases/$(database)/documents/shared_projects/$(shareId)).data.memberUids
          );
        allow delete: if false;
      }
    }
  }
}
